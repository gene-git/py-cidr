#
# installer script for py-cidr
# e.g. Call from PKGBUILD:  
#   ./do-install ${pkgdir}
#
# Default destination is build/pkg
#
set -euo pipefail

if (( $# < 1 )) ; then
    dest="./build/pkg"
else
    dest="$1"
fi

dest=$(realpath "$dest")

/usr/bin/meson install -C build/release --destdir "$dest" > /dev/null

exit 0
